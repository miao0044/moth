{
  "name": "moth",
  "version": "1.0.0",
  "description": "A dark, minimal Markdown editor and EPUB reader for Windows.",
  "author": "miao0044",
  "main": "main.js",
  "scripts": {
    "icons": "node build/generate-icon.js",
    "build": "node esbuild.config.mjs",
    "qa": "node esbuild.config.mjs && electron scripts/qa-electron.cjs",
    "start": "node esbuild.config.mjs && electron .",
    "dist": "npm run icons && node esbuild.config.mjs && electron-builder --win",
    "register-associations": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-file-associations.ps1 -OpenDefaultAppsSettings"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "6.5.3",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "codemirror": "^6.0.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.0",
    "epubjs": "0.3.93",
    "esbuild": "^0.28.0",
    "jszip": "3.10.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  },
  "build": {
    "appId": "com.moth.editor",
    "productName": "Moth",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "style.css",
      "THIRD_PARTY_NOTICES.md",
      "dist/**/*",
      "!dist/*.map"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "txt",
        "name": "Text File",
        "description": "Text File",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown File",
        "description": "Markdown File",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown File",
        "description": "Markdown File",
        "role": "Editor"
      },
      {
        "ext": "json",
        "name": "JSON File",
        "description": "JSON File",
        "role": "Editor"
      },
      {
        "ext": "jsonl",
        "name": "JSON Lines File",
        "description": "JSON Lines File",
        "role": "Editor"
      },
      {
        "ext": "epub",
        "name": "EPUB Book",
        "description": "EPUB eBook",
        "role": "Viewer"
      }
    ]
  }
}
